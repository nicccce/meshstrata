  "components": {
    "securitySchemes": {
      "AdminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "meshstrata_session",
        "description": "B01 opaque server-side session; Secure HttpOnly SameSite; browser Origin and CSRF on writes."
      },
      "CSRF": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      },
      "SubscriptionToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Download-only token in Authorization; no secrets in URL."
      },
      "NodeMTLS": {
        "type": "mutualTLS"
      }
    },
    "schemas": {
      "ID": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,23}_[0-9a-f]{32}$"
      },
      "Revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "Timestamp": {
        "type": "string",
        "format": "date-time"
      },
      "Problem": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "current_revision": {
            "$ref": "#/components/schemas/Revision"
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "JSON pointer"
          },
          "code": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "path",
          "code"
        ],
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Problem"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "RevisionRef": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ID"
          },
          "revision": {
            "$ref": "#/components/schemas/Revision"
          }
        },
        "required": [
          "id",
          "revision"
        ],
        "additionalProperties": false
      },
      "Mutation": {
        "type": "object",
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
