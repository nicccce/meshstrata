          "administrator_authority": false
        },
        "x-sensitive-link": {
          "cache_control": "no-store",
          "referrer_policy": "no-referrer",
          "redirects": false,
          "redact": [
            "path_token",
            "authorization",
            "download_url"
          ],
          "minimum_entropy_bits": 256,
          "check_each_request": [
            "expires_at",
            "revoked_at",
            "token_version"
          ],
          "scope": "single_subscription_download",
          "ordinary_dto_contains_token": false
        },
        "description": "Standard Copy URL import over HTTPS, with a random download-only capability token in the resource path. No Authorization header or administrator cookie is required. Validate expiry/revocation on every request; reset/delete invalidates old links without rotating still-valid proxy identities. Never log/export/analyze the capability URL, echo it in errors or redirect it. B08 implements this reserved operation.",
